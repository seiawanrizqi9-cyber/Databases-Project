model Member {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  phone         String?
  address       String?
  borrowRecords BorrowRecord[]
  user_id       Int?          @unique  // nullable
  user          User?         @relation(fields: [user_id], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@map("members")
  @@index([email])
  @@index([user_id])
}